# Copy this file to .env and fill in real values.
# ─── DATABASE ───────────────────────────────────────
# Supabase Postgres connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ─── SUPABASE STORAGE ───────────────────────────────
# Keep the service-role key on the backend only. Never add it to Flutter or web code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-backend-only-sb-secret-key
# Legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGE_BUCKET=images
SUPABASE_AVATAR_BUCKET=images
SUPABASE_AVATAR_FOLDER=Avatar
SUPABASE_LOGO_FOLDER=Logo
SUPABASE_LOGO_FILENAME=saslogo.png
# Private bucket for medical documents. The backend creates it when needed.
SUPABASE_MEDICAL_LEAVE_BUCKET=medical-leave
SUPABASE_ANNOUNCEMENT_BUCKET=course-announcements

# ─── GEMINI ─────────────────────────────────────────
# Google Gemini API key for the LLM chatbot.
GEMINI_API_KEY=your-gemini-api-key

# ─── OPENROUTER AI ASSISTANT ─────────────────────────
# Keep the real key only in fyp-backend/.env.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=thinkingmachines/inkling-small:free
OPENROUTER_CHAT_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Google Maps JavaScript / 3D Maps browser key. Restrict it to the required
# Maps APIs and the web application's localhost and hosted HTTPS domains.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── JWT ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-64-char-hex-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── APP ────────────────────────────────────────────
APP_ENV=development
# Enable only when the API is behind your trusted HTTPS reverse proxy.
# Production/staging automatically trust the proxy-provided client address.
TRUST_PROXY_HEADERS=false

# ─── SERVER ─────────────────────────────────────────
# Port the local dev server binds to. Single source of truth: both
# both run_backend.bat and stop_backend.bat read this value,
# so changing it here is enough.
#
# 8003 rather than 8000: on Windows the IP Helper service (iphlpsvc) binds
# 127.0.0.1:8000, and a more specific bind wins over uvicorn's 0.0.0.0:8000 —
# so localhost:8000 gets answered by iphlpsvc and the connection is reset.
# Keep the frontends (fyp_web/.env, fyp_flutter) in step with this port.
BACKEND_PORT=8003
RESEND_API_KEY=replace_with_a_new_resend_key
RESEND_FROM_EMAIL=Smart Attendance <no-reply@your-verified-domain.com>
WEB_APP_URL=http://localhost:5173
