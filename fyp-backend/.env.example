# Copy this file to .env and fill in real values.
# ─── DATABASE ───────────────────────────────────────
# Supabase Postgres connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ─── GEMINI ─────────────────────────────────────────
# Google Gemini API key for the LLM chatbot.
GEMINI_API_KEY=your-gemini-api-key

# ─── JWT ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-64-char-hex-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── APP ────────────────────────────────────────────
APP_ENV=development

# ─── DEMO CLOCK (testing only) ──────────────────────
# Pretend the server clock is at another time, so the attendance check-in flow can
# be demoed outside real class hours. Both clients align to /auth/server-time, so
# this moves the backend windows and the app's gating together. Leave it unset
# (or delete the line) for the real clock. NEVER set this in production.
#
#   DEMO_CLOCK=14:30            -> 14:30 campus time, today
#   DEMO_CLOCK=Wednesday 14:30  -> 14:30 on the next/current Wednesday
#
# Pick a time that a real timetable slot covers. The backend logs a "DEMO_CLOCK
# active" line on startup whenever it is on.
# DEMO_CLOCK=

# ─── SERVER ─────────────────────────────────────────
# Port the local dev server binds to. Single source of truth: both
# both run_backend.bat and stop_backend.bat read this value,
# so changing it here is enough.
#
# 8003 rather than 8000: on Windows the IP Helper service (iphlpsvc) binds
# 127.0.0.1:8000, and a more specific bind wins over uvicorn's 0.0.0.0:8000 —
# so localhost:8000 gets answered by iphlpsvc and the connection is reset.
# Keep the frontends (fyp_web/.env, fyp_flutter) in step with this port.
BACKEND_PORT=8003
