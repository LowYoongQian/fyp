# Root-level safety-net .gitignore for FYP project

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
opencode.json

# Editor/IDE configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment Secrets (Crucial safety net for all subfolders)
**/.env
**/.env.*
**/env.json
**/env.*.json
!**/.env.example
!**/env.json.example
!**/env.example.json

# Local Python virtual environments & caches
**/.venv/
**/venv/
**/env/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.cache/

# Local Node/Vite build & dependency files
**/node_modules/
**/dist/
**/dist-ssr/

# Flutter/Dart local caches & build outputs
**/.dart_tool/
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/


# Python tooling caches & test artifacts
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
**/.coverage
**/.coverage.*
**/htmlcov/

# deepface / TensorFlow downloaded model weights (fetched on first use, ~100MB+).
# NOT ml/risk_model.pkl — that one is committed on purpose and loaded at runtime.
**/.deepface/
**/weights/*.h5

# Node/Vite extra caches & debug logs
**/.vite/
**/.eslintcache
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Flutter/Dart extras
**/*.iml
**/.flutter-plugins
**/.packages
**/*.g.dart.bak

# Editor leftovers & local history
**/.history/
**/*.swp
**/*~
**/*.orig
**/*.rej

# Generic local-only files
**/*.log
**/*.bak
**/*.tmp
**/*.local
**/*.sqlite
**/*.sqlite3

# Credentials & signing material (never commit these)
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.keystore
**/key.properties
**/google-services.json
**/GoogleService-Info.plist
**/serviceAccountKey*.json

# OneDrive / Windows sync conflict copies. This repo lives in OneDrive and a doc
# really did get clobbered mid-edit, so keep the duplicates out of commits.
**/*-DESKTOP-*.*
**/*-LAPTOP-*.*
**/* - Copy.*
**/* (1).*
**/* (2).*

#Other
/docs
/scripts
/tests