# Root-level safety-net .gitignore for FYP project

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
opencode.json

# Editor/IDE configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment Secrets (Crucial safety net for all subfolders)
**/.env
**/.env.*
**/env.json
**/env.*.json
!**/.env.example
!**/env.json.example
!**/env.example.json

# Local Python virtual environments & caches
**/.venv/
**/venv/
**/env/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.cache/

# Local Node/Vite build & dependency files
**/node_modules/
**/dist/
**/dist-ssr/

# Flutter/Dart local caches & build outputs
**/.dart_tool/
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/


# Python tooling caches & test artifacts
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/*.egg-info/
**/.coverage
**/.coverage.*
**/htmlcov/

# deepface / TensorFlow downloaded model weights (fetched on first use, ~100MB+).
# NOT ml/risk_model.pkl — that one is committed on purpose and loaded at runtime.
**/.deepface/
**/weights/*.h5

# Node/Vite extra caches & debug logs
**/.vite/
**/.eslintcache
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Flutter/Dart extras
**/*.iml
**/.flutter-plugins
**/.packages
**/*.g.dart.bak

# Editor leftovers & local history
**/.history/
**/*.swp
**/*~
**/*.orig
**/*.rej

# Generic local-only files
**/*.log
**/*.bak
**/*.tmp
**/*.local
**/*.sqlite
**/*.sqlite3

# Credentials & signing material (never commit these)
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.keystore
**/key.properties
**/google-services.json
**/GoogleService-Info.plist
**/serviceAccountKey*.json

# OneDrive / Windows sync conflict copies. This repo lives in OneDrive and a doc
# really did get clobbered mid-edit, so keep the duplicates out of commits.
**/*-DESKTOP-*.*
**/*-LAPTOP-*.*
**/* - Copy.*
**/* (1).*
**/* (2).*

#Other
/docs
/scripts
/tests

# Default-ignore local backend test content; exact formal sources are allowed below.
/fyp-backend/tests/*
/fyp-backend/pytest.ini

# Default-ignore local web/Flutter tests; see the exact formal allowlist below.
/fyp_web/tests/
/fyp_flutter/test/

# Conventional test locations outside the folders above (narrow patterns, no *test*).
__tests__/
integration_test/
test_*.py
*_test.py
*_test.dart
*.test.[jt]s
*.test.[jt]sx
*.test.mjs
*.test.cjs
*.spec.[jt]s
*.spec.[jt]sx
*.spec.mjs
*.spec.cjs

# Only the consolidated root changelog and the root README (the GitHub front page) are versioned.
*.[mM][dD]
!/CHANGELOG.md
!/README.md
# Local captures, recordings, screenshots and reports (never shipped).
/output/
# Test tooling kept on this PC only: the demo-screen capture harness and the ML training scripts.
/fyp_flutter/tool/demo_capture/
/fyp-backend/ml/training/
/fyp-backend/scratch/
/review-workflow/

# Exact formal QA source/config allowlist; local evidence remains ignored.
/qa/*
!/qa/common.py
!/qa/run.py
!/qa/browser.cjs
!/qa/account_fixture.py
!/qa/session_api.py
!/qa/seed_session.py
!/qa/seed_login.py
!/qa/toggle-guest-network.ps1
!/qa/README.md
!/qa/package.json
!/qa/package-lock.json
!/qa/supabase/
/qa/supabase/*
!/qa/supabase/config.toml
!/fyp-backend/tests/conftest.py
!/fyp-backend/tests/test_postgres_routes.py
!/fyp-backend/tests/test_medical_leave_review.py
!/fyp-backend/tests/test_offline_recovery.py
!/fyp-backend/tests/test_auth_access_regression.py
!/fyp-backend/tests/test_account_endpoints.py
!/fyp-backend/tests/test_invalid_class_time.py
!/fyp-backend/tests/test_dashboard_sessions.py
!/fyp-backend/tests/test_alembic_isolated.py
!/fyp-backend/tests/test_mc_acceptance_local.py
!/fyp-backend/tests/test_feedback_local.py
!/fyp-backend/tests/login_widget_test.dart
!/fyp-backend/tests/offline_sync_test.dart
!/fyp-backend/tests/portal_background_sync_test.dart
!/fyp-backend/tests/dashboard_cache_isolation_test.dart
!/fyp-backend/tests/attendance_localization_test.dart
!/fyp-backend/tests/test_face_self_test.py
!/fyp-backend/tests/face_flow_test.dart
!/fyp-backend/domain/face_self_test.py
!/fyp-backend/tests/cache_regression.cjs
!/fyp-backend/tests/mc_workflow.cjs
!/fyp-backend/tests/feedback_workflow.cjs
!/fyp-backend/tests/phase2_cross_platform.cjs
!/fyp_flutter/integration_test/
/fyp_flutter/integration_test/*
!/fyp_flutter/integration_test/qa_login_test.dart
!/fyp_flutter/integration_test/qa_account_isolation_test.dart
!/fyp_flutter/integration_test/qa_cache_upgrade_test.dart
!/fyp_flutter/integration_test/qa_cache_v4_upgrade_test.dart
!/fyp_flutter/integration_test/qa_history_mapping_test.dart
!/fyp_flutter/integration_test/qa_offline_account_test.dart
!/fyp_flutter/integration_test/qa_attendance_test.dart
