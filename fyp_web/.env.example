# Copy this file to .env and adjust. Vite only exposes VITE_-prefixed vars to
# the client, so never put a secret (DB password, API key) in here — anything
# in this file ends up readable in the browser bundle.

# Backend API base URL.
# Must match BACKEND_PORT in fyp-backend/.env. Port 8003, not 8000: on Windows
# the IP Helper service binds 127.0.0.1:8000 and answers before uvicorn does,
# which shows up as ERR_CONNECTION_RESET on every request.
VITE_API_BASE_URL=http://localhost:8003

# Default password assigned to student accounts provisioned from the admin UI.
VITE_DEFAULT_STUDENT_PASSWORD=change-me
